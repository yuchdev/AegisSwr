# Aegis SWR environment template
# Leave values empty here. Copy to .env and fill only what you use.

# AI provider credentials (required for the selected provider)
ANTHROPIC_API_KEY=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
OPENAI_API_KEY=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX

# Amazon Bedrock authentication
# Option 1: Bedrock bearer token

AWS_BEARER_TOKEN_BEDROCK=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
# Region fallback used when Bedrock region is not set in AEGIS__ config

AWS_DEFAULT_REGION=us-east-1
# Option 2: standard AWS credential chain (SigV4)

AWS_ACCESS_KEY_ID=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
AWS_SESSION_TOKEN=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
AWS_PROFILE=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX

# Optional runtime overrides (Settings env prefix: AEGIS__)
AEGIS__BACKENDS__AI__PROVIDER=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
AEGIS__BACKENDS__AI__BEDROCK__MODEL_ID=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
AEGIS__BACKENDS__STORAGE__DATABASE_URL=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX


GITHUB_PERSONAL_ACCESS_TOKEN=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
SENTRY_AUTH_TOKEN=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
SENTRY_HOST=example-host.sentry.io
PAGERDUTY_USER_API_TOKEN=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX
CONTEXT7_API_KEY=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX

